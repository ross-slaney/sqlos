<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The sign-in latency benchmark: password, email-code and hosted sign-ins over HTTP against
    tests/SqlOS.BehaviorLock.Host, on a database the repository's Aspire app host starts. The host
    references SqlOS as source or as the released package, chosen with the behavior lock's switch,
    which flows to it from this project:

      -p:SqlOSUnderTest=source   (default) ProjectReference to src/SqlOS
      -p:SqlOSUnderTest=package  PackageReference SqlOS $(SqlOSBaselineVersion), default 7.2.1

    so one harness measures both builds. It is a project of its own, apart from the FGA benchmark in
    tests/SqlOS.Benchmarks, because nothing here may reference src/SqlOS directly: in package mode
    that reference would replace the package. Run it with scripts/sign-in-benchmark.sh, which builds
    each mode into its own artifacts directory.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SqlOS.Benchmarks.SignIn</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="Aspire.Hosting.Testing" Version="9.4.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlOS.BehaviorLock.Host\SqlOS.BehaviorLock.Host.csproj" />
    <ProjectReference Include="..\SqlOS.IntegrationTests.AppHost\SqlOS.IntegrationTests.AppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The behavior lock's guard that the loaded SqlOS.dll is the build the switch asked for. -->
    <Compile Include="..\SqlOS.BehaviorLock\Infrastructure\SqlOSUnderTest.cs" Link="SqlOSUnderTest.cs" />
  </ItemGroup>
</Project>
